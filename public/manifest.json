{
  "manifest_version": 3,
  "name": "API Mock",
  "version": "0.1.0",
  "description": "在 DevTools 里实时查看页面 API 请求，并改写响应体 / 状态码 / 响应头 / 时序。",
  "minimum_chrome_version": "111",
  "devtools_page": "devtools/devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
