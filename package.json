{
  "name": "api-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome MV3 DevTools 面板：实时抓取页面 API 请求，并改写响应体 / 状态码 / 响应头 / 时序",
  "scripts": {
    "build": "vite build && node scripts/build-content.mjs",
    "dev": "node scripts/watch.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "demo": "node demo/server.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
